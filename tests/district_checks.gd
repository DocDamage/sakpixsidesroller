extends "res://tests/living_world_checks.gd"

func relocate(at: Vector2) -> void:
	Pad.release()
	level.player.respawn(at)
	level.player.invincible = 1000
	level.player.traversal.reset()
	await ticks(22)

func run() -> void:
	hub = root.get_node("Controller")
	hub.focus_pause_enabled = false
	hub.settings_path = "res://artifacts/district-test-controller.cfg"
	hub.defaults()
	Input.use_accumulated_input = false
	level = load("res://scenes/halloween_town.tscn").instantiate()
	root.add_child(level)
	current_scene = level
	await ticks(20)
	for enemy: Node2D in get_nodes_in_group("enemies"):
		enemy.set_physics_process(false)
	var district: Node2D = level.district
	var motor: RefCounted = level.player.traversal
	print("DISTRICT CONTENT: ",district.spaces.size()," spaces / ",level.hud.total_coins," coins / ",get_nodes_in_group("enemies").size()," enemies / ",level.profile.builder.LEDGES.size()," surfaces")
	check(level.stage_width == 19200 and district.spaces.size() == 26,"Stage 1 contains twenty-six connected spaces, including a chapel undercroft return route")
	check(level.profile.builder.SOLIDS.size() >= 15 and level.profile.builder.LEDGES.size() > 35,"Authored district has independent floor heights, shafts, balconies, crossings and retaining walls")
	check(district.climbs.size() == 16 and district.platforms.size() == 8 and district.hooks.size() == 5,"District installs offset apothecary stairs, chapel return stair, four lifts, moving crossings, a return tram and grapple anchors")
	check(level.checkpoints.size() == 8 and level.hud.checkpoint_total == 8,"Eight sanctuaries support the longer exploration route and backtracking")
	check(level.profile.seals[0].y == -750 and level.profile.seals[1].y == 1370 and level.profile.seals[2].y == -170,"Three objectives belong to distinct belfry, cistern and garden branches")
	check(level.audio.variants.size() >= 32 and level.audio.variants["foot_stone"].size() == 2 and level.audio.variants["rat_lunge"].size() == 2,"Source SFX kit retains contextual variations alongside the additional enemy attack cues")
	check(level.audio.music.get_meta("song_path").contains("The Haunted Manor"),"District preserves the requested Haunted Manor soundtrack")
	check(get_nodes_in_group("district_shadows").size() >= 25 and district.lighting.hero.shadow_enabled,"Local source lights and structural occluders replace a flat darkness overlay")
	await relocate(Vector2(2440,590))
	Pad.axis(JOY_AXIS_LEFT_Y,-1)
	await ticks(165)
	Pad.axis(JOY_AXIS_LEFT_Y,0)
	await ticks(20)
	check(absf(level.player.position.y-380) < 4 and level.player.is_on_floor() and motor.climbing == -1,"Controller Up exits the first apothecary stair onto its intermediate floor")
	Pad.axis(JOY_AXIS_LEFT_Y,1)
	await ticks(165)
	Pad.axis(JOY_AXIS_LEFT_Y,0)
	await ticks(20)
	check(absf(level.player.position.y-600) < 4 and motor.climbing == -1,"Controller Down descends the ladder and releases cleanly at street level")
	await relocate(Vector2(4180,200))
	Pad.axis(JOY_AXIS_LEFT_Y,-1)
	await ticks(126)
	Pad.axis(JOY_AXIS_LEFT_Y,0)
	Pad.axis(JOY_AXIS_LEFT_X,-1)
	Pad.button(JOY_BUTTON_A,true)
	await ticks(10)
	Pad.button(JOY_BUTTON_A,false)
	await ticks(23)
	Pad.axis(JOY_AXIS_LEFT_X,0)
	await ticks(50)
	check(level.player.is_on_floor() and absf(level.player.position.y+80) < 4 and level.player.position.x > 3960 and level.player.position.x < 4180,"Player can dismount the short tower-entry rope onto the eaves using controller jump and direction")
	await relocate(Vector2(10898,-30))
	Pad.axis(JOY_AXIS_LEFT_X,-1)
	await ticks(8)
	Pad.button(JOY_BUTTON_A,true)
	await ticks(4)
	Pad.button(JOY_BUTTON_A,false)
	await ticks(4)
	var before_wall: Vector2 = level.player.position
	Pad.button(JOY_BUTTON_A,true)
	await ticks(2)
	Pad.button(JOY_BUTTON_A,false)
	Pad.axis(JOY_AXIS_LEFT_X,0)
	await ticks(14)
	check(level.player.position.x > before_wall.x+40 and level.player.position.y < before_wall.y-45,"Wall jump kicks away from the chimney with real collision and upward momentum")
	await relocate(Vector2(8200,1530))
	Pad.axis(JOY_AXIS_LEFT_X,1)
	var before_swim: Vector2 = level.player.position
	await ticks(55)
	Pad.axis(JOY_AXIS_LEFT_X,0)
	check(motor.swimming and level.player.position.x > before_swim.x+100 and motor.breath < 14,"Deep cistern water supports swimming, current movement and a visible breath reserve")
	var swim_y: float = level.player.position.y
	Pad.axis(JOY_AXIS_LEFT_Y,-1)
	Pad.button(JOY_BUTTON_A,true)
	await ticks(2)
	Pad.button(JOY_BUTTON_A,false)
	await ticks(35)
	Pad.axis(JOY_AXIS_LEFT_Y,0)
	check(level.player.position.y < swim_y-85,"Controller Up and a jump stroke propel the swimmer toward the surface")
	await relocate(Vector2(13400,630))
	check(level.player.is_on_floor() and not motor.swimming and district.surface_kind(level.player.position) == "wet","Shallow garden banks support wading on their actual bed instead of forcing a swim")
	district.upgrades["moon_hook"] = true
	await relocate(Vector2(13020,-122))
	Pad.axis(JOY_AXIS_LEFT_Y,-1)
	Pad.button(JOY_BUTTON_Y,true)
	await ticks(1)
	Pad.button(JOY_BUTTON_Y,false)
	var grapple_start: Vector2 = level.player.position
	var maximum_step: float = 0
	var last: Vector2 = grapple_start
	for i: int in 35:
		await ticks(1)
		maximum_step = maxf(maximum_step,level.player.position.distance_to(last))
		last = level.player.position
	Pad.axis(JOY_AXIS_LEFT_Y,0)
	check(level.player.position.distance_to(grapple_start) > 130 and maximum_step < 20,"Up + Use grapples to a visible hook through continuous motion without teleporting")
	district.activate_switch("bell_winch")
	district.activate_switch("prison_release")
	district.activate_switch("sluice_control")
	await ticks(520)
	check(district.gates.quarter.body.collision_layer == 0 and district.gates.trapdoor.body.collision_layer == 0 and district.opened.has("bell_winch") and district.platforms[0].shuttle,"Belfry winch releases the callable return cage and prison release opens the trapdoor")
	check(absf(district.waters[0].position.y-1720) < 1 and district.gates.sluice.body.collision_layer == 0 and district.waters[0].current < 0,"Sluice visibly lowers the actual swim volume and opens the flooded return route")
	var moved: Vector2 = district.platforms[2].position
	var travel: float = 0
	for i: int in 150:
		await ticks(1)
		travel = maxf(travel,district.platforms[2].position.distance_to(moved))
	check(travel > 60,"Winch lift travels physically between the watchhouse and aqueduct, including endpoint dwell")
	await relocate(Vector2(10600,590))
	var open_before: int = district.opened.size()
	level.respawn()
	await ticks(3)
	check(district.opened.size() == open_before and district.waters[0].target_y == 1720,"Death preserves opened shortcuts and the chosen water state")
	Pad.button(JOY_BUTTON_LEFT_SHOULDER,true)
	await ticks(2)
	Pad.button(JOY_BUTTON_LEFT_SHOULDER,false)
	await ticks(2)
	check(paused and district.map_overlay.visible,"Controller LB opens the district map and pauses the world")
	Pad.button(JOY_BUTTON_LEFT_SHOULDER,true)
	await ticks(2)
	Pad.button(JOY_BUTTON_LEFT_SHOULDER,false)
	await ticks(2)
	check(not paused and not district.map_overlay.visible,"Controller LB closes the map without opening another menu")
	Pad.release()
	level.queue_free()
	await ticks(6)
	OS.delay_msec(120)
	await ticks(4)
	print("DISTRICT RESULT: %d/%d checks passed" % [checks-failures,checks])
	quit(1 if failures else 0)
