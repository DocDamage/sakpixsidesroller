# Code-only repository. Asset packs, derived media, engine binaries, imports,
# research footage and local captures stay on disk and must never be committed.
*
!/.gitignore
!/.gitattributes
!/README.md
!/README.txt
!/AGENTS.md
!/DESIGN_REFERENCE.txt
!/STAGE1_DESIGN_AUDIT.txt
!/project.godot
!/Play*.cmd

!/scripts/
/scripts/*
!/scripts/*.gd
!/scripts/*.gd.uid
!/scripts/*.gdshader
!/scripts/*.gdshader.uid
!/scripts/*.py

!/scenes/
/scenes/*
!/scenes/*.tscn

!/tests/
/tests/*
!/tests/*.gd
!/tests/*.gd.uid
!/tests/*.py

# These JSON files contain paths/settings/provenance only, never image/audio data.
!/assets/
/assets/*
!/assets/effects_manifest.json
!/assets/audio/
/assets/audio/*
!/assets/audio/district/
/assets/audio/district/*
!/assets/audio/district/sources.json
!/assets/audio/enemies/
/assets/audio/enemies/*
!/assets/audio/enemies/sources.json
!/assets/terrain/
/assets/terrain/*
!/assets/terrain/ferr2d/
/assets/terrain/ferr2d/*
!/assets/terrain/ferr2d/source_manifest.json
!/assets/terrain/ferr2d/README.txt
